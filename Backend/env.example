# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Database (MSSQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=ievo-tech-pm
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_something_long_and_random
JWT_EXPIRES_IN=8h

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── File uploads ──────────────────────────────────────────────────────────────
FILE_STORAGE_ROOT=/Users/jatin/Documents/DOC_UPLOADS
MAX_FILE_SIZE_MB=100

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
# Used to send welcome emails to newly registered users.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your_app_specific_password   ← generate at myaccount.google.com/apppasswords
#
# Office 365 / Outlook example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@yourdomain.com
#   SMTP_PASS=your_password
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=I.EVO ERP <noreply@ievo.in>

# URL shown in the welcome email's "Open I.EVO ERP" button
APP_URL=http://localhost:5173

# ── Messaging ─────────────────────────────────────────────────────────────────
# How many minutes after sending a message the sender can edit it (default: 10)
MESSAGE_EDIT_DEADLINE_MINUTES=10

# ── Activity Insights cron ───────────────────────────────────────────────────
# Posts an automated task-status summary into each PM Activity's group chat
# (progress %, overdue/due-soon/blocked tasks, what's next). Standard 5-field
# cron syntax (min hour day month weekday), evaluated in the server's local
# timezone. Leave unset/blank to disable the job entirely — nothing is posted
# and no timer is scheduled.
#
# Examples:
#   Daily at 9am:            0 9 * * *
#   Every weekday at 9am:    0 9 * * 1-5
#   Every 6 hours:           0 */6 * * *
ACTIVITY_INSIGHTS_CRON_SCHEDULE=

# How many days back "Completed recently" looks in the message (default: 7).
ACTIVITY_INSIGHTS_LOOKBACK_DAYS=7
# How many days ahead counts as "due soon" (not yet overdue) (default: 3).
ACTIVITY_INSIGHTS_DUE_SOON_DAYS=3